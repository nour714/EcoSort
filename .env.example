# EcoSort Server Configuration
HOST=0.0.0.0
PORT=5000
DEBUG=False

# Model Configuration
MODEL_PATH=model.keras
NORM_MODE=zero_one
RESIZE_MODE=direct
TTA_ENABLED=False

# Confidence Gating Thresholds
CONF_HIGH=75.0
CONF_LOW=45.0
MARGIN_MIN=20.0

# Image Quality Thresholds
BLUR_VAR_MIN=35.0
DARK_MEAN_MAX=30.0
BRIGHT_MEAN_MIN=230.0
FLAT_STD_MIN=15.0

# Request Limits (Bytes, default 10MB)
MAX_CONTENT_LENGTH=10485760

# CORS Origins (Use * for dev; in production set to explicit domain e.g. https://ecosort.kfs.edu.eg)
CORS_ORIGINS=*
